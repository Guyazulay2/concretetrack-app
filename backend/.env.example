# ConcreteTrack — .env

# DB (dev: sqlite, prod: postgresql)
DATABASE_URL=sqlite+aiosqlite:///./concretetrack.db

# JWT
JWT_SECRET=change-this-secret-in-production

# Cloudinary (https://cloudinary.com - חינמי עד 25GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# מספרי הסדרנים מופרדים בפסיק:
ADMIN_WHATSAPP_PHONES=+972501234567,+972509876543
